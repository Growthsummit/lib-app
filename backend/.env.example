PORT=3001
# Comma-separated frontend origins allowed to call the API (no trailing slash).
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Set to true if you want Vercel preview deployments (*.vercel.app) to call the API.
ALLOW_VERCEL_PREVIEWS=false
# Required in every environment. The app always connects to Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
